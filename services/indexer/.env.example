# KindlePool Indexer Configuration

# Stellar network RPC URL (testnet by default)
KINDPOOL_RPC_URL=https://soroban-testnet.stellar.org

# Deployed contract ID to listen for events
KINDPOOL_CONTRACT_ID=

# API server port
KINDPOOL_API_PORT=3001

# Rate limit: max requests per minute per IP
KINDPOOL_RATE_LIMIT=100

# Poll interval in milliseconds (how often to check for new events)
KINDPOOL_POLL_INTERVAL=10000

# Database file path (default: ./data/kindlepool.db)
KINDPOOL_DB_PATH=./data/kindlepool.db
