# KindlePool API — environment configuration
# Copy to .env for local development. All values are optional unless noted.

# ─── Stellar / Soroban ──────────────────────────────────────────
KINDPOOL_RPC_URL=https://soroban-testnet.stellar.org
KINDPOOL_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
KINDPOOL_CONTRACT_ID=

# ─── MongoDB Atlas (persistent DB) ─────────────────────────────
KINDPOOL_MONGO_URL=

# ─── Unified backend service toggles ───────────────────────────
KINDPOOL_ENABLE_RELAYER=true
KINDPOOL_ENABLE_NOTIFIER=true
KINDPOOL_ENABLE_MONITOR=true

# ─── Indexer ────────────────────────────────────────────────────
KINDPOOL_API_PORT=3001
KINDPOOL_POLL_INTERVAL=10000
KINDPOOL_RATE_LIMIT=100
KINDPOOL_DB_PATH=./data/kindlepool.db
KINDPOOL_ADMIN_KEY=
KINDPOOL_DEV_API_KEY=

# ─── Relayer ────────────────────────────────────────────────────
KINDPOOL_RELAYER_SECRET=
KINDPOOL_RELAYER_PORT=3002
KINDPOOL_RELAYER_RATE_LIMIT=50
KINDPOOL_RELAYER_FEE=100000
KINDPOOL_RELAYER_TXB_TTL_SECONDS=300
KINDPOOL_RELAYER_ALLOWLIST=

# ─── Notifier ───────────────────────────────────────────────────
KINDPOOL_NOTIFIER_PORT=3003
KINDPOOL_NOTIFIER_RATE_LIMIT=30
KINDPOOL_NOTIFIER_API_KEY=
KINDPOOL_NOTIFIER_DB_PATH=./data/notifier.db

# ─── Monitor ────────────────────────────────────────────────────
KINDPOOL_MONITOR_RPC=https://soroban-testnet.stellar.org
KINDPOOL_INDEXER_URL=http://localhost:3001
KINDPOOL_MONITOR_INTERVAL=300000
KINDPOOL_ANOMALY_THRESHOLD=10
KINDPOOL_ALERT_WEBHOOK=
KINDPOOL_MONITOR_DATA=./data
KINDPOOL_MONITOR_DB_PATH=./data/monitor.db
KINDPOOL_FEE_GROWTH_THRESHOLD=100000000
KINDPOOL_DISPUTE_STUCK_HOURS=168

# ─── Auth (magic-link + JWT) ────────────────────────────────────
# Required in production — JWT_SECRET must be set (backend refuses to boot
# in prod with the dev default).
RESEND_API_KEY=
JWT_SECRET=
JWT_TTL=7d
# Public app URL used in magic-link emails (required in prod).
KINDPOOL_APP_URL=http://localhost:5173
